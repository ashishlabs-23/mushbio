# ==============================================================================
# MUSHBIO BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or set via Firebase Secrets CLI (`firebase functions:secrets:set`)
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_NAME=MushBio
APP_URL=http://localhost:8080

# Razorpay Payment Gateway (Phase 10)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Transactional Email / Notifications (Phase 12)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.mushbio.com
SMTP_PASS=placeholder_smtp_pass
EMAIL_FROM="MushBio Organics <orders@mushbio.com>"

# Admin Notification Webhook (Optional)
ADMIN_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/placeholder
